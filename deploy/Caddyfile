{
  # HTTP/3 uses QUIC over UDP. Keep HTTPS on HTTP/1.1 and HTTP/2 so a
  # client network that blocks or mishandles UDP/443 cannot make the portal
  # appear unreachable.
  servers {
    protocols h1 h2
  }
}

{$DOMAIN} {
  encode zstd gzip
  reverse_proxy app:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

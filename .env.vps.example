DOMAIN=connect.example.com
POSTGRES_DB=conecta_waba
POSTGRES_USER=conecta_waba
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_SIZE=10
WORKER_DATABASE_POOL_SIZE=10
REDIS_URL=redis://redis:6379
# Genera con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes-in-base64
SESSION_TTL_SECONDS=43200
APP_PORT=3000

META_APP_ID=
META_APP_SECRET=
META_CONFIGURATION_ID=
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_SIGNATURE_REQUIRED=true
WEBHOOK_MAX_BODY_BYTES=1048576
N8N_TIMEOUT_MS=10000
CHATWOOT_TIMEOUT_MS=10000
META_TIMEOUT_MS=15000
WORKER_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=8
QUEUE_RETENTION_DAYS=30
FAILED_JOB_RETENTION_DAYS=180
WHATSAPP_VERIFY_TOKEN=

# Solo para ejecutar `docker compose run --rm` y crear el primer administrador.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=Administrador

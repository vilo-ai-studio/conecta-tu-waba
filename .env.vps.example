DOMAIN=connect.example.com
POSTGRES_DB=conecta_waba
POSTGRES_USER=conecta_waba
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_SIZE=20
# Genera con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes-in-base64
SESSION_TTL_SECONDS=43200
APP_PORT=3000

META_APP_ID=
META_APP_SECRET=
META_CONFIGURATION_ID=
META_GRAPH_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=

# Solo para ejecutar `docker compose run --rm` y crear el primer administrador.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=Administrador
